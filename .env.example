# Default credentials used for devices without their own username/password.
ARUBA_DEFAULT_USERNAME=admin
ARUBA_DEFAULT_PASSWORD=
ARUBA_API_VERSION=v10.09

# NetBox source of truth (optional). Leave empty if you do not use NetBox.
NETBOX_URL=
NETBOX_TOKEN=

# Infrahub source of truth (optional). Leave empty if you do not use Infrahub.
INFRAHUB_URL=
INFRAHUB_TOKEN=

# SFTP configuration backup server (optional).
# backup_config uses these credentials; never pass them in MCP arguments.
CX_BACKUP_SFTP_HOST=
CX_BACKUP_SFTP_USERNAME=
CX_BACKUP_SFTP_PASSWORD=
# CX_BACKUP_SFTP_PORT=22
# CX_BACKUP_SFTP_DIRECTORY=/network-backups/cx
# CX_BACKUP_SFTP_ALLOWED_HOSTS=
# CX_BACKUP_SFTP_TIMEOUT=30

# TFTP configuration backup server (optional; TFTP is unencrypted).
CX_BACKUP_TFTP_HOST=
# CX_BACKUP_TFTP_PORT=69
# CX_BACKUP_TFTP_DIRECTORY=network-backups/cx
# CX_BACKUP_TFTP_ALLOWED_HOSTS=
# CX_BACKUP_TFTP_TIMEOUT=30